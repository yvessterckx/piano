    <!-- "*" on beat 2 lifts the pedal; a stray "*" on beat 4 has no pedal to lift. Both under the
         staff of the "Ped." signs: OSMD pairs pedal marks per staff and drops a "*" written under
         another staff than its "Ped." (see docs/decisions.md). -->
    <measure number="3">
      <note>
        <pitch><step>E</step><octave>5</octave></pitch>
        <duration>4</duration><voice>1</voice><type>whole</type><staff>1</staff>
      </note>
      <backup><duration>4</duration></backup>
